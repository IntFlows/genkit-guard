{
  "name": "@intflows/genkit-guard",
  "description": "Intflows Genkit Guard",
  "maintainers": [
    "Hemant Kohli"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/IntFlows/genkit-guard"
  },
  "keywords": [
    "genkit",
    "genkit-guard",
    "intflows",
    "guardrails",
    "intent-analysis",
    "AI-safety",
    "piimasking",
    "content-moderation",
    "NLP",
    "transformers",
    "huggingface"
  ],
  "license": "Apache-2.0",
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "CHANGELOG.md",
    "README.md",
    "package.json",
    "scripts/",
    "dist/"
  ],
  "scripts": {
    "prepare-models": "node scripts/download-model.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:types && npm run test:unit && npm run test:storage && npm run test:concurrency",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:types": "tsc --noEmit --ignoreConfig --module NodeNext --moduleResolution NodeNext --target ESNext --strict --skipLibCheck scripts/test-types.ts",
    "test:storage": "npm run build && node scripts/test-storage.js",
    "test:concurrency": "npm run build && node scripts/test-concurrent-vault.js",
    "test:redis": "npm run build && node scripts/test-redis-vault.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "genkit": "1.39.0"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@vitest/coverage-v8": "^4.1.11",
    "genkit": "^1.39.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
