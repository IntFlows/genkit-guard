{
  "name": "@intflows/genkit-guard",
  "description": "Intflows Genkit Guard",
  "maintainers": [
    "Hemant Kohli"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/IntFlows/genkit-guard"
  },
  "keywords": [
    "genkit",
    "genkit-guard",
    "intflows",
    "guardrails",
    "intent-analysis",
    "AI-safety",
    "piimasking",
    "content-moderation",
    "NLP",
    "transformers",
    "huggingface"
  ],
  "license": "Apache-2.0",
  "version": "0.0.11",
  "type": "module",
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "README.md",
    "package.json",
    "scripts/",
    "dist/"
  ],
  "scripts": {
    "prepare-models": "node scripts/download-model.js",
    "build": "tsc",
    "test": "npm run test:types && npm run test:storage && npm run test:concurrency",
    "test:types": "tsc --noEmit --ignoreConfig --module NodeNext --moduleResolution NodeNext --target ESNext --strict --skipLibCheck scripts/test-types.ts",
    "test:storage": "npm run build && node scripts/test-storage.js",
    "test:concurrency": "npm run build && node scripts/test-concurrent-vault.js",
    "test:redis": "npm run build && node scripts/test-redis-vault.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "genkit": "1.39.0"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "genkit": "^1.39.0",
    "typescript": "^6.0.3"
  }
}
